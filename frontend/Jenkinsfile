
pipeline {
    agent {
        label 'react-agent'
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '102186470246'
        ECR_REPOSITORY = 'ecommerce-frontend'
        IMAGE_TAG = "${BUILD_NUMBER}"

        EKS_CLUSTER_NAME = 'ecommerce-eks-cluster'
        K8S_NAMESPACE = 'ecommerce'
        K8S_DEPLOYMENT = 'ecommerce-frontend'
        K8S_CONTAINER = 'ecommerce-frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Frontend Build') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    sh '''
                        docker build -t $ECR_REPOSITORY:$IMAGE_TAG .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v "$HOME/.cache/trivy:/root/.cache/" \
                        aquasec/trivy:latest image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        $ECR_REPOSITORY:$IMAGE_TAG || true
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION |
                        docker login --username AWS --password-stdin \
                        $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                    docker tag $ECR_REPOSITORY:$IMAGE_TAG \
                        $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:$IMAGE_TAG

                    docker push \
                        $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:$IMAGE_TAG
                '''
            }
        }

        stage('Configure EKS') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --region $AWS_REGION \
                        --name $EKS_CLUSTER_NAME

                    kubectl get nodes
                '''
            }
        }

        stage('Deploy Frontend') {
            steps {
                sh '''
                    set -e

                    echo "Deploying frontend build: ${BUILD_NUMBER}"

                    sed "s|IMAGE_TAG_PLACEHOLDER|${BUILD_NUMBER}|g" \
                        kubernetes/frontend/frontend-deployment.yaml \
                        | kubectl apply -f -

                    echo "Waiting for frontend rollout..."

                    kubectl rollout status deployment/ecommerce-frontend \
                        -n ecommerce --timeout=180s
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "Frontend Deployments"
                    kubectl get deployments -n $K8S_NAMESPACE

                    echo "Frontend Pods"
                    kubectl get pods -n $K8S_NAMESPACE

                    echo "Frontend Services"
                    kubectl get services -n $K8S_NAMESPACE
                '''
            }
        }
    }

    post {
        success {
            echo 'Frontend successfully deployed to EKS!'
        }

        failure {
            echo 'Frontend deployment failed. Check Jenkins console output.'
        }

        always {
            echo 'Frontend pipeline execution completed.'
        }
    }
}
