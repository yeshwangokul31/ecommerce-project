
pipeline {
    agent {
        label 'python-agent'
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '102186470246'
        ECR_REPOSITORY = 'ecommerce-backend'
        CLUSTER_NAME = 'ecommerce-eks-cluster'
        NAMESPACE = 'ecommerce'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Python Dependencies') {
            steps {
                dir('backend') {
                    sh '''
                        python3 -m venv venv
                        venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t $ECR_REPOSITORY:$IMAGE_TAG .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v "$HOME/.cache/trivy:/root/.cache/" \
                        aquasec/trivy:latest image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        ecommerce-backend:$IMAGE_TAG || true
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION |
                    docker login --username AWS --password-stdin \
                        $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                    docker tag $ECR_REPOSITORY:$IMAGE_TAG \
                        $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:$IMAGE_TAG

                    docker push \
                        $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:$IMAGE_TAG
                '''
            }
        }

        // EKS CONFIGURATION

        stage('Configure EKS Cluster') {
            steps {
                sh '''
                    aws sts get-caller-identity

                    aws eks update-kubeconfig \
                        --region $AWS_REGION \
                        --name $CLUSTER_NAME

                    kubectl get nodes
                '''
            }
        }

        // BACKEND DEPLOYMENT

        stage('Deploy Backend') {
            steps {
                sh '''
                    kubectl apply -f kubernetes/namespace.yaml

                    kubectl apply -f kubernetes/backend/

                    kubectl set image deployment/backend \
                        backend=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:$IMAGE_TAG \
                        -n $NAMESPACE

                    kubectl rollout status deployment/backend \
                        -n $NAMESPACE \
                        --timeout=5m
                '''
            }
        }

        // VALIDATE DEPLOYMENT

        stage('Verify Backend Deployment') {
            steps {
                sh '''
                    echo "Checking backend pods..."
                    kubectl get pods -n $NAMESPACE

                    echo "Checking backend deployment..."
                    kubectl get deployment backend -n $NAMESPACE

                    echo "Checking backend service..."
                    kubectl get svc backend -n $NAMESPACE
                '''
            }
        }
    }

    post {
        success {
            echo 'Backend successfully deployed to EKS!'
        }

        failure {
            echo 'Backend deployment failed. Check Jenkins console output.'
        }
    }
}
