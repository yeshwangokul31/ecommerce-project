
pipeline {
    agent {
        label 'python-agent'
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '102186470246'
        ECR_REPOSITORY = 'ecommerce-backend'
        CLUSTER_NAME = 'ecommerce-eks-cluster'
        NAMESPACE = 'ecommerce'
        DEPLOYMENT_NAME = 'ecommerce-backend'
        CONTAINER_NAME = 'backend'
        IMAGE_TAG = "${BUILD_NUMBER}"
        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Python Dependencies') {
            steps {
                dir('backend') {
                    sh '''
                        python3 -m venv venv
                        venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t $ECR_REPOSITORY:$IMAGE_TAG .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v "$HOME/.cache/trivy:/root/.cache/" \
                        aquasec/trivy:latest image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        $ECR_REPOSITORY:$IMAGE_TAG || true
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION |
                    docker login --username AWS --password-stdin $ECR_URI
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                    docker tag $ECR_REPOSITORY:$IMAGE_TAG \
                        $ECR_URI/$ECR_REPOSITORY:$IMAGE_TAG

                    docker push \
                        $ECR_URI/$ECR_REPOSITORY:$IMAGE_TAG
                '''
            }
        }

        stage('Configure EKS Cluster') {
            steps {
                sh '''
                    aws sts get-caller-identity

                    aws eks update-kubeconfig \
                        --region $AWS_REGION \
                        --name $CLUSTER_NAME

                    kubectl get nodes
                '''
            }
        }

        stage('Create Namespace') {
            steps {
                sh '''
                    kubectl create namespace $NAMESPACE \
                        --dry-run=client -o yaml | kubectl apply -f -
                '''
            }
        }

        stage('Deploy Backend') {
            steps {
                sh '''
                    kubectl apply -f kubernetes/backend/ -n $NAMESPACE

                    kubectl set image deployment/$DEPLOYMENT_NAME \
                        $CONTAINER_NAME=$ECR_URI/$ECR_REPOSITORY:$IMAGE_TAG \
                        -n $NAMESPACE

                    kubectl rollout status deployment/$DEPLOYMENT_NAME \
                        -n $NAMESPACE \
                        --timeout=5m
                '''
            }
        }

        stage('Verify Backend Deployment') {
            steps {
                sh '''
                    echo "Checking backend pods..."
                    kubectl get pods -n $NAMESPACE

                    echo "Checking backend deployment..."
                    kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE

                    echo "Checking backend service..."
                    kubectl get svc -n $NAMESPACE
                '''
            }
        }
    }

    post {
        success {
            echo 'Backend successfully deployed to EKS!'
        }

        failure {
            echo 'Backend deployment failed. Check Jenkins console output.'
        }
    }
}
